clear; clc; close all;

R = 1;
L = 0.3;
w = 314;
Vm = 220 * sqrt(2);

tf = 0.3;
dt = 0.0001;

t = 0:dt:tf;
N = length(t);

I_rk4 = zeros(1, N);
I_rk4(1) = 0;

for n = 1:(N-1)
    tn = t(n);
    In = I_rk4(n);
    
    K1 = (Vm * sin(w * tn) - R * In) / L;
    K2 = (Vm * sin(w * (tn + dt/2)) - R * (In + (dt/2) * K1)) / L;
    K3 = (Vm * sin(w * (tn + dt/2)) - R * (In + (dt/2) * K2)) / L;
    K4 = (Vm * sin(w * (tn + dt)) - R * (In + dt * K3)) / L;
    
    I_rk4(n+1) = In + (dt / 6) * (K1 + 2*K2 + 2*K3 + K4);
end

fprintf('=== Section 2.1 Result ===\n');
fprintf('Calculated current I(1) at t = %.4f s: %.7f A\n', t(2), I_rk4(2));

phi = atan((L * w) / R);
A = (L * w * Vm) / (R^2 + (L * w)^2);
Ig = A * exp(-(R/L) * t) + (Vm / sqrt(R^2 + (L * w)^2)) * sin(w * t - phi);

error_I = abs(Ig - I_rk4);

% --- التعديل حسب توجيهات الأستاذة للرسم باستخدام subplot ---
figure('Name', 'RL Circuit Simulation and Error Analysis', 'NumberTitle', 'off');

% الرسم الأول (مقارنة التيارين باستخدام الطريقة المطلوبة)
subplot(3,1,1);
plot(t, Ig, 'r:', t, I_rk4, '*');
grid on;
xlabel('Time t (s)');
ylabel('Current (A)');
legend('Ig (Theoretical)', 'I_rk4 (Numerical)', 'Location', 'northeast');
title('Comparison between Theoretical and RK4 Current');

% الرسم الثاني (التيار العددي وحده أو بالشكل المطلوب)
subplot(3,1,2);
plot(t, I_rk4, 'b-');
grid on;
xlabel('Time t (s)');
ylabel('I_{rk4} (A)');
title('Numerical Current I_{rk4}(t)');

% الرسم الثالث (الخطأ المطلق)
subplot(3,1,3);
plot(t, error_I, 'k-');
grid on;
xlabel('Time t (s)');
ylabel('Absolute Error (A)');
title('Error between Theoretical and Numerical Current');
